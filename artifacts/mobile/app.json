{
  "expo": {
    "name": "Coimbatore Sathyam Super Store Vendor Portal",
    "slug": "coimbatoresathyamsuperstorevendorportal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coimbatoresathyamsuperstorevendorportal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coimbatoresathyamsuperstorevendorportal.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow Sathyam Vendor Portal to save price tag PNGs to your Photos.",
        "NSPhotoLibraryUsageDescription": "Allow Sathyam Vendor Portal to save price tag PNGs to your Photos."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.coimbatoresathyamsuperstorevendorportal.app",
      "versionCode": 10,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Sathyam Vendor Portal to save price tag PNGs to your Photos.",
          "savePhotosPermission": "Allow Sathyam Vendor Portal to save price tag PNGs to your Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b03b64f6-10af-487d-b3cb-7dbf0dc32795"
      }
    }
  }
}
