{
  "expo": {
    "name": "Coimbatore Sathyam Super Store Vendor Portal",
    "slug": "coimbatoresathyamsuperstorevendorportal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coimbatoresathyamsuperstorevendorportal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coimbatoresathyamsuperstorevendorportal.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false,
      "package": "com.coimbatoresathyamsuperstorevendorportal.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b03b64f6-10af-487d-b3cb-7dbf0dc32795"
      }
    }
  }
}
